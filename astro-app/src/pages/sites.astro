---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { listSupportedSites } from '@lib/services/portal-registry.js';

const regionNames = new Intl.DisplayNames(['en'], { type: 'region' });
const tierLabels = {
  core: 'Core',
  experimental: 'Experimental',
  'manual-only': 'Manual HTML',
} as const;
const tierClasses = {
  core: 'bg-emerald-100 text-emerald-700',
  experimental: 'bg-amber-100 text-amber-700',
  'manual-only': 'bg-blue-100 text-blue-700',
} as const;

const sites = listSupportedSites().map((site) => ({
  ...site,
  countryName: regionNames.of(site.country) ?? site.country,
  extractionRatePercent:
    typeof site.expectedExtractionRate === 'number'
      ? Math.round(site.expectedExtractionRate * 100)
      : null,
}));

const totalCountries = new Set(sites.map((site) => site.country)).size;
const tierCounts = {
  core: sites.filter((site) => site.supportTier === 'core').length,
  experimental: sites.filter((site) => site.supportTier === 'experimental').length,
  manualOnly: sites.filter((site) => site.supportTier === 'manual-only').length,
};
---
<BaseLayout title="Supported Sites - Property Web Scraper">

<section class="max-w-6xl mx-auto px-4 py-12">
  <PageHeader
    title="Supported Sites"
    subtitle={`PropertyWebScraper currently exposes ${sites.length} named portal mappings across ${totalCountries} countries. Support tiers and browser-rendering requirements come directly from the canonical portal registry.`}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Supported Sites' },
    ]}
  />

  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-xl shadow-md p-5">
      <p class="text-sm text-gray-500">Named portals</p>
      <p class="text-2xl font-bold">{sites.length}</p>
    </div>
    <div class="bg-white rounded-xl shadow-md p-5">
      <p class="text-sm text-gray-500">Countries covered</p>
      <p class="text-2xl font-bold">{totalCountries}</p>
    </div>
    <div class="bg-white rounded-xl shadow-md p-5">
      <p class="text-sm text-gray-500">Core / experimental</p>
      <p class="text-2xl font-bold">{tierCounts.core} / {tierCounts.experimental}</p>
    </div>
    <div class="bg-white rounded-xl shadow-md p-5">
      <p class="text-sm text-gray-500">Manual HTML required</p>
      <p class="text-2xl font-bold">{tierCounts.manualOnly}</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
    {sites.map((site) => (
      <div class="bg-white rounded-xl shadow-md p-5 flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <h5 class="font-semibold text-base font-mono">{site.scraper}</h5>
          <span class={`text-xs px-2 py-0.5 rounded-full ${tierClasses[site.supportTier]}`}>{tierLabels[site.supportTier]}</span>
        </div>
        <div class="flex items-center gap-2 text-xs text-gray-500">
          <span class="bg-gray-100 px-2 py-0.5 rounded-full">{site.countryName}</span>
          {site.extractionRatePercent !== null && <span>Expected rate: {site.extractionRatePercent}%</span>}
        </div>
        <p class="text-sm text-gray-400">{site.host}</p>
        <p class="text-xs text-gray-500 m-0">
          {site.requiresJsRendering
            ? 'Requires browser-rendered HTML for reliable extraction.'
            : 'Supports direct URL-based extraction.'}
        </p>
        <div class="flex gap-2">
          <a href={`/extract/url`} class="bg-blue-600 text-white text-xs px-3 py-1.5 rounded-lg hover:bg-blue-700 no-underline inline-flex items-center gap-1">
            <i class="bi bi-link-45deg"></i> Extract
          </a>
          <a href={site.url} target="_blank" rel="noreferrer" class="bg-gray-100 text-gray-700 text-xs px-3 py-1.5 rounded-lg hover:bg-gray-200 no-underline inline-flex items-center gap-1">
            <i class="bi bi-box-arrow-up-right"></i> Visit
          </a>
        </div>
      </div>
    ))}
  </div>

  <div class="bg-gradient-to-br from-gray-50 to-gray-200 rounded-2xl p-8 mt-8">
    <div class="flex items-start gap-4">
      <div class="hidden md:block text-3xl text-blue-600 shrink-0">
        <i class="bi bi-plus-circle"></i>
      </div>
      <div>
        <h4 class="font-semibold text-lg mb-3">Need a different site?</h4>
        <p class="text-sm text-gray-600 m-0">
          PropertyWebScraper uses JSON-based mapping configs for named portals, and it also
          includes a generic fallback mapping when you provide browser-rendered HTML for an
          unsupported host. If you need a first-class scraper for a new portal, you can add one
          without changing the extraction pipeline itself.
          <a href="https://github.com/RealEstateWebTools/property_web_scraper" target="_blank" class="text-blue-600 hover:underline">
            See the docs on GitHub
          </a>.
        </p>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
